---
import AdminLayout from "../../../layouts/AdminLayout.astro";
---

<AdminLayout title="Add New Blog Post">
  <div class="max-w-[1600px] mx-auto flex flex-col gap-10 h-full">
    <header class="flex flex-col gap-2">
      <h1 class="text-[12px] uppercase tracking-[0.4em] text-black-soft/40 font-medium">Blog / New</h1>
      <h2 class="text-4xl md:text-[50px] font-light text-black-soft m-0 uppercase tracking-tight">Create Post</h2>
    </header>

    <!-- Split View Container -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 h-full">
        
        <!-- Left: Form -->
        <div class="bg-white p-10 shadow-xl rounded-sm border border-black-soft/5 h-fit">
            <div id="error-msg" class="hidden bg-red-50 text-red-500 p-4 mb-6 text-sm border-l-4 border-red-500"></div>

            <form id="blog-form" class="flex flex-col gap-10">
                
                <!-- Main Info -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 border-b border-black-soft/5 pb-10">
                    <div class="flex flex-col gap-2">
                        <label for="title" class="text-[10px] uppercase tracking-[0.2em] text-black-soft/60">Post Title</label>
                        <input type="text" name="title" id="title" required class="border-b border-black-soft/20 py-2 focus:border-gold outline-none transition-colors font-light text-lg" placeholder="e.g. Design Trends 2024" />
                    </div>
                    <div class="flex flex-col gap-2">
                        <label for="slug" class="text-[10px] uppercase tracking-[0.2em] text-black-soft/60">Friendly URL (Slug)</label>
                        <input type="text" name="slug" id="slug" class="border-b border-black-soft/20 py-2 focus:border-gold outline-none transition-colors font-light text-lg" placeholder="e.g. alvarez-kitchen" />
                    </div>
                    <div class="flex flex-col gap-2">
                        <label for="author" class="text-[10px] uppercase tracking-[0.2em] text-black-soft/60">Author</label>
                        <input type="text" name="author" id="author" class="border-b border-black-soft/20 py-2 focus:border-gold outline-none transition-colors font-light text-sm" value="BA Kitchen & Bath" />
                    </div>
                    <div class="flex flex-col gap-2">
                        <label for="status" class="text-[10px] uppercase tracking-[0.2em] text-black-soft/60">Status</label>
                        <select name="status" id="status" class="border-b border-black-soft/20 py-2 focus:border-gold outline-none transition-colors font-light text-sm bg-transparent">
                            <option value="published">Published</option>
                            <option value="draft">Draft</option>
                        </select>
                    </div>
                    <div class="flex flex-col gap-2 md:col-span-2">
                         <label for="main_image" class="text-[10px] uppercase tracking-[0.2em] text-black-soft/60">Main Image</label>
                         <input type="file" name="main_image" id="main_image" accept="image/*" required class="font-light text-xs text-black-soft/60 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-[10px] file:uppercase file:tracking-widest file:bg-beige-light file:text-black-soft hover:file:bg-gold hover:file:text-white file:transition-colors" />
                    </div>
                    <div class="flex flex-col gap-2 md:col-span-2">
                        <label for="short_description" class="text-[10px] uppercase tracking-[0.2em] text-black-soft/60">Listing Summary (Short Description)</label>
                        <textarea name="short_description" id="short_description" rows="2" class="border border-black-soft/10 p-4 focus:border-gold outline-none transition-colors font-light text-sm resize-none" placeholder="Brief summary for the listing page..."></textarea>
                    </div>
                </div>

                <!-- SEO Section -->
                <div class="grid grid-cols-1 gap-8 border-b border-black-soft/5 pb-10">
                    <h3 class="text-[12px] uppercase tracking-[0.2em] text-black-soft/40 font-medium">SEO & Meta Tags</h3>
                    <div class="flex flex-col gap-2">
                        <label for="meta_title" class="text-[10px] uppercase tracking-[0.2em] text-black-soft/60">Meta Title</label>
                        <input type="text" name="meta_title" id="meta_title" class="border-b border-black-soft/20 py-2 focus:border-gold outline-none transition-colors font-light text-sm" placeholder="Title for Google search results" />
                    </div>
                    <div class="flex flex-col gap-2">
                        <label for="meta_description" class="text-[10px] uppercase tracking-[0.2em] text-black-soft/60">Meta Description</label>
                        <textarea name="meta_description" id="meta_description" rows="2" class="border border-black-soft/10 p-4 focus:border-gold outline-none transition-colors font-light text-sm resize-none" placeholder="Description for search results (max 160 chars)"></textarea>
                    </div>
                </div>

                <!-- Dynamic Sections -->
                <div class="flex flex-col gap-6">
                    <div class="flex items-center justify-between">
                        <h3 class="text-[14px] uppercase tracking-[0.2em] text-black-soft font-medium">Content Sections</h3>
                        <button type="button" id="add-section-btn" class="bg-black-soft text-white px-6 py-2 uppercase tracking-widest text-[10px] hover:bg-gold transition-colors">
                            + Add Section
                        </button>
                    </div>

                    <div id="sections-container" class="flex flex-col gap-8">
                        <!-- Sections will be added here -->
                    </div>
                </div>

                <!-- Hidden Input for JSON -->
                <input type="hidden" name="sections" id="sections-json" />

                <div class="flex justify-end gap-6 pt-10 border-t border-black-soft/5">
                    <a href="/admin/blog" class="px-8 py-4 uppercase tracking-[0.3em] text-[11px] font-medium text-black-soft/40 hover:text-black-soft transition-colors">Cancel</a>
                    <button type="submit" id="submit-btn" class="bg-gold text-white px-12 py-4 uppercase tracking-[0.3em] text-[11px] font-medium hover:bg-black-soft transition-colors shadow-lg">Publish Post</button>
                </div>
            </form>
        </div>

        <!-- Right: Live Preview -->
        <div class="hidden lg:block relative">
            <div class="sticky top-10 bg-white shadow-2xl rounded-sm border border-black-soft/5 overflow-hidden h-[800px] overflow-y-auto w-full">
                <!-- Preview Header -->
                <div class="bg-black-soft text-white p-4 text-[10px] uppercase tracking-widest text-center">Live Preview</div>
                
                <!-- Preview Content -->
                <div id="preview-area" class="bg-white">
                    <!-- Dynamic Preview Content -->
                </div>
            </div>
        </div>
    </div>
  </div>
</AdminLayout>

<script is:inline>
    const addBtn = document.getElementById('add-section-btn');
    const container = document.getElementById('sections-container');
    const form = document.getElementById('blog-form');
    const jsonInput = document.getElementById('sections-json');
    const previewArea = document.getElementById('preview-area');
    const errorMsg = document.getElementById('error-msg');
    const submitBtn = document.getElementById('submit-btn');
    
    // Inputs
    const titleInput = document.getElementById('title');
    const descInput = document.getElementById('short_description');
    const mainImageInput = document.getElementById('main_image');

    let sectionCount = 0;

    // --- RENDER HELPERS ---
    const renderPreview = () => {
        if (!previewArea) return;

        let html = '';
        
        // Hero
        const titleVal = titleInput?.value || "Post Title";
        const descVal = descInput?.value || "Short description...";
        const authorVal = document.getElementById('author')?.value || "BA Kitchen & Bath";
        
        let mainImgSrc = 'https://placehold.co/1200x600'; 
        if (mainImageInput?.files && mainImageInput.files[0]) {
             mainImgSrc = URL.createObjectURL(mainImageInput.files[0]);
        }

        html += `
            <section class="h-[300px] relative flex items-end justify-center bg-cover bg-center" style="background-image: url('${mainImgSrc}');">
                <div class="absolute inset-0 bg-black/30"></div>
                <div class="relative z-10 text-center pb-10 px-6 max-w-4xl mx-auto">
                    <span class="text-[10px] uppercase tracking-[0.2em] text-white/60 mb-2 block">Blog | ${authorVal}</span>
                    <h1 class="text-2xl text-white font-light leading-tight mb-2">${titleVal}</h1>
                    <p class="text-white/80 text-sm font-light max-w-lg mx-auto italic">${descVal}</p>
                </div>
            </section>
            <article class="p-10 flex flex-col gap-8 max-w-2xl mx-auto">
        `;

        // Sections
        const sectionElements = container?.querySelectorAll('.section-item');
        if (sectionElements) {
            sectionElements.forEach(el => {
                const element = el;
                const typeSelector = element.querySelector('.type-selector');
                if (!typeSelector) return;
                const type = typeSelector.value;
                let content = '';
                
                if (type === 'title' || type === 'paragraph') {
                    const localInput = element.querySelector('.content-input');
                    content = localInput ? localInput.value : '';
                    if (type === 'title') {
                        const level = element.querySelector('.level-selector')?.value || 'h2';
                        html += `<${level} class="text-2xl font-light text-black-soft">${content}</${level}>`;
                    }
                    if (type === 'paragraph') html += `<div class="text-base text-black-soft/70 font-light leading-relaxed whitespace-pre-line">${content}</div>`;
                } else if (type === 'image_single') {
                    const imgInput = element.querySelector('input[type="file"]');
                    let imgSrc = 'https://placehold.co/600x400';
                    if (imgInput && imgInput.files && imgInput.files[0]) {
                        imgSrc = URL.createObjectURL(imgInput.files[0]);
                    }
                    html += `<img src="${imgSrc}" class="w-full h-auto object-cover rounded-sm shadow-sm" />`;
                } else if (type === 'image_double') {
                    const inputs = element.querySelectorAll('input[type="file"]');
                    let src1 = 'https://placehold.co/300x400';
                    let src2 = 'https://placehold.co/300x400';

                    const input1 = inputs[0];
                    const input2 = inputs[1];

                    if (input1 && input1.files && input1.files[0]) src1 = URL.createObjectURL(input1.files[0]);
                    if (input2 && input2.files && input2.files[0]) src2 = URL.createObjectURL(input2.files[0]);
                    
                    html += `
                        <div class="grid grid-cols-2 gap-4">
                            <img src="${src1}" class="w-full h-[200px] object-cover rounded-sm shadow-sm" />
                            <img src="${src2}" class="w-full h-[200px] object-cover rounded-sm shadow-sm" />
                        </div>
                    `;
                }
            });
        }

        html += `</article>`;
        previewArea.innerHTML = html;
    };


    // --- SECTION LOGIC ---
    const getTemplate = (id, type = 'paragraph', content = '', level = 'h2', alt1 = '', alt2 = '') => {
        let inputHtml = '';
        if (type === 'title') {
            inputHtml = `
                <div class="flex flex-col gap-4">
                    <div class="flex flex-col gap-2 w-1/4">
                        <label class="text-[10px] uppercase tracking-[0.2em] text-black-soft/60">Heading Level</label>
                        <select class="level-selector border-b border-black-soft/20 py-2 focus:border-gold outline-none bg-transparent font-light text-sm">
                            <option value="h2" ${level === 'h2' ? 'selected' : ''}>H2 (Large)</option>
                            <option value="h3" ${level === 'h3' ? 'selected' : ''}>H3 (Medium)</option>
                            <option value="h4" ${level === 'h4' ? 'selected' : ''}>H4 (Small)</option>
                        </select>
                    </div>
                    <input type="text" class="content-input w-full border-b border-black-soft/20 py-2 focus:border-gold outline-none font-medium text-lg" placeholder="Enter section title" value="${content.replace(/"/g, '&quot;')}" />
                </div>
            `;
        }
        else if (type === 'paragraph') {
            inputHtml = `
                <div class="flex flex-col gap-2">
                    <div class="flex gap-2 mb-1">
                        <button type="button" onclick="formatText(this, 'b')" class="px-2 py-1 text-[10px] bg-gray-100 hover:bg-gold hover:text-white transition-colors uppercase tracking-widest">B</button>
                        <button type="button" onclick="formatText(this, 'i')" class="px-2 py-1 text-[10px] bg-gray-100 hover:bg-gold hover:text-white transition-colors uppercase tracking-widest">I</button>
                        <button type="button" onclick="addLink(this)" class="px-2 py-1 text-[10px] bg-gray-100 hover:bg-gold hover:text-white transition-colors uppercase tracking-widest">Link</button>
                    </div>
                    <textarea class="content-input w-full border border-black-soft/10 p-3 focus:border-gold outline-none font-light text-sm resize-y min-h-[100px]" placeholder="Enter paragraph text...">${content}</textarea>
                </div>
            `;
        }
        else if (type === 'image_single') {
            inputHtml = `
                <div class="flex flex-col gap-4">
                    <div class="flex flex-col gap-2">
                        <label class="text-[10px] uppercase tracking-[0.2em] text-black-soft/60">Upload Image</label>
                        <input type="file" name="section_${id}_img_1" accept="image/*" class="font-light text-xs text-black-soft/60" />
                    </div>
                    <div class="flex flex-col gap-2">
                        <label class="text-[10px] uppercase tracking-[0.2em] text-black-soft/60">Image Alt Text</label>
                        <input type="text" class="alt-input-1 border-b border-black-soft/20 py-2 focus:border-gold outline-none font-light text-sm" placeholder="Describe image for SEO" value="${alt1.replace(/"/g, '&quot;')}" />
                    </div>
                </div>
            `;
        }
        else if (type === 'image_double') {
             inputHtml = `
                <div class="grid grid-cols-2 gap-8">
                     <div class="flex flex-col gap-4">
                        <div class="flex flex-col gap-2">
                            <label class="text-[10px] uppercase tracking-[0.2em] text-black-soft/60">Image Left</label>
                            <input type="file" name="section_${id}_img_1" accept="image/*" class="font-light text-xs text-black-soft/60" />
                        </div>
                        <div class="flex flex-col gap-2">
                            <label class="text-[10px] uppercase tracking-[0.2em] text-black-soft/60">Alt Text (Left)</label>
                            <input type="text" class="alt-input-1 border-b border-black-soft/20 py-2 focus:border-gold outline-none font-light text-sm" placeholder="SEO description" value="${alt1.replace(/"/g, '&quot;')}" />
                        </div>
                    </div>
                     <div class="flex flex-col gap-4">
                        <div class="flex flex-col gap-2">
                            <label class="text-[10px] uppercase tracking-[0.2em] text-black-soft/60">Image Right</label>
                            <input type="file" name="section_${id}_img_2" accept="image/*" class="font-light text-xs text-black-soft/60" />
                        </div>
                        <div class="flex flex-col gap-2">
                            <label class="text-[10px] uppercase tracking-[0.2em] text-black-soft/60">Alt Text (Right)</label>
                            <input type="text" class="alt-input-2 border-b border-black-soft/20 py-2 focus:border-gold outline-none font-light text-sm" placeholder="SEO description" value="${alt2.replace(/"/g, '&quot;')}" />
                        </div>
                    </div>
                </div>
            `;
        }

        return `
        <div class="section-item bg-beige-light/30 p-6 border border-black-soft/5 relative group" data-id="${id}" data-alt1="${alt1}" data-alt2="${alt2}" data-level="${level}">
            <div class="absolute top-4 right-4 flex gap-2">
                <button type="button" title="Move Up" class="text-black-soft/30 hover:text-gold transition-colors" onclick="moveSection(this, -1)">
                     <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M14.707 12.707a1 1 0 01-1.414 0L10 9.414l-3.293 3.293a1 1 0 01-1.414-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 010 1.414z" clip-rule="evenodd" /></svg>
                </button>
                <button type="button" title="Move Down" class="text-black-soft/30 hover:text-gold transition-colors" onclick="moveSection(this, 1)">
                     <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
                </button>
                <button type="button" class="remove-section text-black-soft/30 hover:text-red-500 transition-colors" onclick="if(confirm('Delete this section?')) { this.closest('.section-item').remove(); window.dispatchEvent(new Event('preview-update')); }">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
                    </svg>
                </button>
            </div>
            
            <div class="flex flex-col gap-4">
                <div class="flex flex-col gap-2 w-1/3">
                    <label class="text-[10px] uppercase tracking-[0.2em] text-black-soft/60">Section Type</label>
                    <select class="type-selector border-b border-black-soft/20 py-2 focus:border-gold outline-none bg-transparent font-light text-sm">
                        <option value="paragraph" ${type === 'paragraph' ? 'selected' : ''}>Paragraph (Text)</option>
                        <option value="title" ${type === 'title' ? 'selected' : ''}>Section Title</option>
                        <option value="image_single" ${type === 'image_single' ? 'selected' : ''}>Single Image</option>
                        <option value="image_double" ${type === 'image_double' ? 'selected' : ''}>Double Image</option>
                    </select>
                </div>

                <div class="content-area mt-2">
                    ${inputHtml}
                </div>
            </div>
        </div>
        `;
    };

    // --- FORMATTING HELPERS ---
    window.formatText = (btn, tag) => {
        const textarea = btn.closest('.flex-col').querySelector('textarea');
        const start = textarea.selectionStart;
        const end = textarea.selectionEnd;
        const text = textarea.value;
        const selected = text.substring(start, end);
        const before = text.substring(0, start);
        const after = text.substring(end);
        
        textarea.value = before + `<${tag}>` + selected + `</${tag}>` + after;
        textarea.dispatchEvent(new Event('input', { bubbles: true }));
    };

    window.addLink = (btn) => {
        const url = prompt('Enter URL:', 'https://');
        if (!url) return;
        const textarea = btn.closest('.flex-col').querySelector('textarea');
        const start = textarea.selectionStart;
        const end = textarea.selectionEnd;
        const text = textarea.value;
        const selected = text.substring(start, end);
        const before = text.substring(0, start);
        const after = text.substring(end);
        
        textarea.value = before + `<a href="${url}">` + (selected || 'link text') + `</a>` + after;
        textarea.dispatchEvent(new Event('input', { bubbles: true }));
    };

    window.moveSection = (btn, direction) => {
        const section = btn.closest('.section-item');
        if (direction === -1 && section.previousElementSibling) {
            section.parentNode.insertBefore(section, section.previousElementSibling);
        } else if (direction === 1 && section.nextElementSibling) {
            section.parentNode.insertBefore(section.nextElementSibling, section);
        }
        window.dispatchEvent(new Event('preview-update'));
    };

    const addSection = (type = 'paragraph', content = '', level = 'h2', alt1 = '', alt2 = '') => {
        sectionCount++;
        container.insertAdjacentHTML('beforeend', getTemplate(sectionCount, type, content, level, alt1, alt2));
        
        const newSection = container.lastElementChild;
        const select = newSection.querySelector('.type-selector');

        select.addEventListener('change', (e) => {
             const newType = e.target.value;
             const id = newSection.dataset.id;
             newSection.querySelector('.content-area').innerHTML = getTemplate(id, newType, '', 'h2', '', '').split('<div class="content-area mt-2">')[1]?.split('</div>\n            </div>\n        </div>')[0] || 'Error loading template area'; 
             
             if (newType === 'title') {
                 newSection.querySelector('.content-area').innerHTML = `
                    <div class="flex flex-col gap-4">
                        <div class="flex flex-col gap-2 w-1/4">
                            <label class="text-[10px] uppercase tracking-[0.2em] text-black-soft/60">Heading Level</label>
                            <select class="level-selector border-b border-black-soft/20 py-2 focus:border-gold outline-none bg-transparent font-light text-sm">
                                <option value="h2">H2 (Large)</option>
                                <option value="h3">H3 (Medium)</option>
                                <option value="h4">H4 (Small)</option>
                            </select>
                        </div>
                        <input type="text" class="content-input w-full border-b border-black-soft/20 py-2 focus:border-gold outline-none font-medium text-lg" placeholder="Enter section title" />
                    </div>
                `;
             } else if (newType === 'paragraph') {
                 newSection.querySelector('.content-area').innerHTML = `
                    <div class="flex flex-col gap-2">
                        <div class="flex gap-2 mb-1">
                            <button type="button" onclick="formatText(this, 'b')" class="px-2 py-1 text-[10px] bg-gray-100 hover:bg-gold hover:text-white transition-colors uppercase tracking-widest">B</button>
                            <button type="button" onclick="formatText(this, 'i')" class="px-2 py-1 text-[10px] bg-gray-100 hover:bg-gold hover:text-white transition-colors uppercase tracking-widest">I</button>
                            <button type="button" onclick="addLink(this)" class="px-2 py-1 text-[10px] bg-gray-100 hover:bg-gold hover:text-white transition-colors uppercase tracking-widest">Link</button>
                        </div>
                        <textarea class="content-input w-full border border-black-soft/10 p-3 focus:border-gold outline-none font-light text-sm resize-y min-h-[100px]" placeholder="Enter paragraph text..."></textarea>
                    </div>
                `;
             } else if (newType === 'image_single') {
                 newSection.querySelector('.content-area').innerHTML = `
                    <div class="flex flex-col gap-4">
                        <div class="flex flex-col gap-2">
                            <label class="text-[10px] uppercase tracking-[0.2em] text-black-soft/60">Upload New Image</label>
                            <input type="file" name="section_${id}_img_1" accept="image/*" class="font-light text-xs text-black-soft/60" />
                        </div>
                        <div class="flex flex-col gap-2">
                            <label class="text-[10px] uppercase tracking-[0.2em] text-black-soft/60">Image Alt Text</label>
                            <input type="text" class="alt-input-1 border-b border-black-soft/20 py-2 focus:border-gold outline-none font-light text-sm" placeholder="Describe image for SEO" />
                        </div>
                    </div>
                `;
             } else if (newType === 'image_double') {
                 newSection.querySelector('.content-area').innerHTML = `
                    <div class="grid grid-cols-2 gap-8">
                         <div class="flex flex-col gap-4">
                            <div class="flex flex-col gap-2">
                                <label class="text-[10px] uppercase tracking-[0.2em] text-black-soft/60">Image Left</label>
                                <input type="file" name="section_${id}_img_1" accept="image/*" class="font-light text-xs text-black-soft/60" />
                            </div>
                            <div class="flex flex-col gap-2">
                                <label class="text-[10px] uppercase tracking-[0.2em] text-black-soft/60">Alt Text (Left)</label>
                                <input type="text" class="alt-input-1 border-b border-black-soft/20 py-2 focus:border-gold outline-none font-light text-sm" placeholder="SEO description" />
                            </div>
                        </div>
                         <div class="flex flex-col gap-4">
                            <div class="flex flex-col gap-2">
                                <label class="text-[10px] uppercase tracking-[0.2em] text-black-soft/60">Image Right</label>
                                <input type="file" name="section_${id}_img_2" accept="image/*" class="font-light text-xs text-black-soft/60" />
                            </div>
                            <div class="flex flex-col gap-2">
                                <label class="text-[10px] uppercase tracking-[0.2em] text-black-soft/60">Alt Text (Right)</label>
                                <input type="text" class="alt-input-2 border-b border-black-soft/20 py-2 focus:border-gold outline-none font-light text-sm" placeholder="SEO description" />
                            </div>
                        </div>
                    </div>
                `;
             }
             renderPreview();
        });

        newSection.addEventListener('input', renderPreview);
        newSection.addEventListener('change', renderPreview);
    };

    addBtn.addEventListener('click', () => {
        addSection();
        renderPreview();
    });

    // Global listeners
    titleInput.addEventListener('input', renderPreview);
    descInput.addEventListener('input', renderPreview);
    mainImageInput.addEventListener('change', renderPreview);
    window.addEventListener('preview-update', renderPreview);
    
    // Form Submit
    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const sections = [];
        const sectionElements = container.querySelectorAll('.section-item');

        sectionElements.forEach((el) => {
            const type = el.querySelector('.type-selector').value;
            const id = el.dataset.id;
            const sectionData = { type };

            if (type === 'title') {
                sectionData.content = el.querySelector('.content-input')?.value || '';
                sectionData.title_level = el.querySelector('.level-selector')?.value || 'h2';
            } else if (type === 'paragraph') {
                sectionData.content = el.querySelector('.content-input')?.value || '';
            } else if (type === 'image_single') {
                sectionData.image_1_key = `section_${id}_img_1`;
                sectionData.image_alt_1 = el.querySelector('.alt-input-1')?.value || '';
            } else if (type === 'image_double') {
                sectionData.image_1_key = `section_${id}_img_1`;
                sectionData.image_2_key = `section_${id}_img_2`;
                sectionData.image_alt_1 = el.querySelector('.alt-input-1')?.value || '';
                sectionData.image_alt_2 = el.querySelector('.alt-input-2')?.value || '';
            }

            sections.push(sectionData);
        });

        jsonInput.value = JSON.stringify(sections);
        
        submitBtn.disabled = true;
        submitBtn.innerText = 'PREPARING...';
        errorMsg.classList.add('hidden');

        const xhr = new XMLHttpRequest();
        xhr.open('POST', '/api/blog.php?action=create', true);

        xhr.upload.addEventListener('progress', (e) => {
            if (e.lengthComputable) {
                const percent = Math.round((e.loaded / e.total) * 100);
                submitBtn.innerText = 'UPLOADING... ' + percent + '%';
            }
        });

        xhr.onload = function() {
            submitBtn.innerText = 'PROCESSING...';
            if (xhr.status >= 200 && xhr.status < 300) {
                try {
                    const json = JSON.parse(xhr.responseText);
                    if (json.success) {
                        window.location.href = '/admin/blog';
                    } else {
                        if (json.error === "Unauthorized") window.location.href = '/admin/login';
                        else {
                            errorMsg.innerText = json.error || 'Failed to publish post';
                            errorMsg.classList.remove('hidden');
                            submitBtn.disabled = false;
                            submitBtn.innerText = 'Publish Post';
                        }
                    }
                } catch (e) {
                     errorMsg.innerText = 'Invalid server response.';
                     errorMsg.classList.remove('hidden');
                     submitBtn.disabled = false;
                     submitBtn.innerText = 'Publish Post';
                }
            } else {
                errorMsg.innerText = 'Server error. Please try again.';
                errorMsg.classList.remove('hidden');
                submitBtn.disabled = false;
                submitBtn.innerText = 'Publish Post';
            }
        };

        xhr.onerror = function() {
            errorMsg.innerText = 'Network error. Please try again.';
            errorMsg.classList.remove('hidden');
            submitBtn.disabled = false;
            submitBtn.innerText = 'Publish Post';
        };

        xhr.send(new FormData(form));
    });

    renderPreview();
</script>
