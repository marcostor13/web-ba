---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';

// This is still using client-side fetch for content to match the original architecture,
// but now it extracts the slug from the URL path.
---

<Layout title="Article | Blog">
  <Header />
  <main class="bg-[#F3EBE3]">
    <div id="loader" class="fixed inset-0 z-50 flex items-center justify-center bg-white">
      <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-gold"></div>
    </div>

    <div id="article-content" class="hidden">
       <!-- Hero Image -->
       <section id="hero-section" class="w-full h-[60vh] md:h-[80vh] bg-cover bg-center" style="background-image: url('');">
       </section>

       <!-- Title & Intro Section -->
       <section class="max-w-4xl mx-auto px-6 pt-16 pb-8 text-center flex flex-col items-center gap-6">
          <div class="reveal reveal-up">
              <span class="text-[12px] md:text-[14px] uppercase tracking-[0.2em] text-black-soft/60 font-light">
                  <span id="post-category">Blog</span> | <span id="post-author">BA Kitchen & Bath</span>
              </span>
              <h1 id="post-title" class="text-4xl md:text-[60px] lg:text-[72px] text-black-soft font-light leading-tight mt-6 mb-8">
              </h1>
              <p id="post-desc" class="text-[16px] md:text-[18px] text-black-soft/80 font-light leading-relaxed max-w-3xl mx-auto italic">
              </p>
          </div>
       </section>

       <!-- Content Sections -->
       <article id="sections-container" class="max-w-[900px] mx-auto px-6 pb-24 flex flex-col gap-12">
          <!-- Sections inserted here -->
       </article>
         
       <!-- Related Posts -->
       <section class="bg-white/30 py-24 px-6 md:px-[54px] lg:px-[140px] border-t border-black/5">
          <div class="max-w-[1200px] mx-auto">
              <h3 class="text-xl font-light text-black-soft mb-12 uppercase tracking-widest text-center">Related Posts</h3>
              <div id="related-grid" class="grid grid-cols-1 md:grid-cols-3 gap-10">
                  <!-- Related posts here -->
              </div>
          </div>
       </section>
    </div>

    <script is:inline>
      async function init() {
        // Get slug from URL path: /blog/article/[slug]
        const pathSegments = window.location.pathname.split('/');
        const slug = pathSegments[pathSegments.length - 1] || pathSegments[pathSegments.length - 2];
        
        if (!slug || slug === 'article') {
          // Check query param as fallback
          const params = new URLSearchParams(window.location.search);
          const qSlug = params.get('slug');
          if (!qSlug) {
             window.location.href = '/blog';
             return;
          }
           window.location.href = `/blog/article/${qSlug}`;
           return;
        }

        try {
          const res = await fetch(`/api/blog.php?action=get&slug=${slug}`);
          const json = await res.json();
          
          if (!json.success || !json.data) {
            window.location.href = '/blog';
            return;
          }

          const post = json.data;
          const sections = json.sections || [];
          
          // Update Meta Tags dynamically for client-side SEO
          document.title = (post.meta_title || post.title) + " | Blog";
          const metaDesc = document.querySelector('meta[name="description"]');
          if (metaDesc) metaDesc.setAttribute('content', post.meta_description || post.short_description || '');
          
          // OG Tags
          const ogTitle = document.querySelector('meta[property="og:title"]');
          if (ogTitle) ogTitle.setAttribute('content', post.meta_title || post.title);
          const ogDesc = document.querySelector('meta[property="og:description"]');
          if (ogDesc) ogDesc.setAttribute('content', post.meta_description || post.short_description || '');
          const ogImage = document.querySelector('meta[property="og:image"]');
          if (ogImage && post.main_image) ogImage.setAttribute('content', window.location.origin + post.main_image);

          // Populate Hero & Intro
          if (post.main_image) {
              document.getElementById('hero-section').style.backgroundImage = `url('${post.main_image}')`;
          }
          document.getElementById('post-title').innerText = post.title;
          document.getElementById('post-author').innerText = post.author || 'BA Kitchen & Bath';
          document.getElementById('post-desc').innerText = post.short_description || '';

          // Populate Sections
          const sectionsHtml = sections.map((section, index) => {
            let innerHtml = '';
            if (section.type === 'title') {
                const tag = section.title_level || 'h2';
                const classes = tag === 'h2' ? 'text-2xl md:text-[32px]' : (tag === 'h3' ? 'text-xl md:text-[28px]' : 'text-lg md:text-[24px]');
                innerHtml = `<${tag} class="${classes} font-light text-black-soft mb-6 text-center leading-tight">${section.content_text || ''}</${tag}>`;
            } else if (section.type === 'paragraph') {
                innerHtml = `<div class="prose-custom text-[16px] md:text-[18px] text-black-soft/90 font-light leading-[1.7] tracking-normal text-center max-w-2xl mx-auto">${section.content_text || ''}</div>`;
            } else if (section.type === 'image_single') {
                if (section.image_path_1) {
                    innerHtml = `<div class="my-6"><img src="${section.image_path_1}" alt="${section.image_alt_1 || post.title}" class="w-full h-auto object-cover rounded-sm shadow-sm" /></div>`;
                }
            } else if (section.type === 'image_double') {
                let imgs = '';
                if (section.image_path_1) imgs += `<img src="${section.image_path_1}" alt="${section.image_alt_1 || 'Gallery 1'}" class="w-full h-[300px] md:h-[500px] object-cover rounded-sm shadow-sm" />`;
                if (section.image_path_2) imgs += `<img src="${section.image_path_2}" alt="${section.image_alt_2 || 'Gallery 2'}" class="w-full h-[300px] md:h-[500px] object-cover rounded-sm shadow-sm" />`;
                if (imgs) {
                    innerHtml = `<div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-6">${imgs}</div>`;
                }
            }
            return innerHtml ? `<div class="reveal reveal-up delay-${(index % 3) * 100} w-full">${innerHtml}</div>` : '';
          }).join('');
          
          document.getElementById('sections-container').innerHTML = sectionsHtml;

          // Enable view and animations
          document.getElementById('loader').style.display = 'none';
          document.getElementById('article-content').classList.remove('hidden');

          setTimeout(() => {
            document.querySelectorAll('.reveal').forEach(el => el.classList.add('revealed'));
          }, 100);

          loadRelated(post.id);

        } catch (e) {
          console.error(e);
          window.location.href = '/blog';
        }
      }

      async function loadRelated(currentId) {
        try {
          const res = await fetch('/api/blog.php?action=list');
          const json = await res.json();
          if (json.success && json.data) {
            const related = json.data.filter(p => (p.id != currentId && p.status !== 'draft')).slice(0, 3);
            const gridHtml = related.map(p => `
              <a href="/blog/article/${p.slug}" class="group flex flex-col gap-4 reveal reveal-up">
                <div class="overflow-hidden aspect-[4/3] bg-black-soft/5">
                    ${p.main_image ? `<img src="${p.main_image}" alt="${p.title}" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />` : ''}
                </div>
                <h4 class="text-lg font-light text-black-soft group-hover:text-gold transition-colors text-center">${p.title}</h4>
              </a>
            `).join('');
            document.getElementById('related-grid').innerHTML = gridHtml;

            setTimeout(() => {
              document.getElementById('related-grid').querySelectorAll('.reveal').forEach(el => el.classList.add('revealed'));
            }, 100);
          }
        } catch(e) {}
      }

      window.addEventListener('load', init);
    </script>
    <style is:global>
       .prose-custom p { margin-bottom: 1.5rem; }
       .prose-custom b, .prose-custom strong { font-weight: 700; }
       .prose-custom i, .prose-custom em { font-style: italic; }
       .prose-custom a { color: #956B24; text-decoration: underline; }
    </style>
  </main>
</Layout>
